// Cloudflare Workers (static assets only — no server code).
// Deploy: `npm run deploy` (builds, then `wrangler deploy`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "graunke-dev",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Attaches graunke.dev (zone must be on the same Cloudflare account).
  "routes": [
    { "pattern": "graunke.dev", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": true
}
