---
import Container from "@components/Container.astro";
import { SITE, SOCIALS } from "@consts";

const links = [
  ...SOCIALS,
  { NAME: "Email", HREF: `mailto:${SITE.EMAIL}` },
  { NAME: "RSS", HREF: "/rss.xml" },
];
---

<footer class="mt-24 border-t border-zinc-200 py-8 text-sm dark:border-zinc-800">
  <Container class="flex flex-col-reverse gap-4 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-zinc-500">
      &copy; {new Date().getFullYear()} {SITE.NAME} · {SITE.LOCATION}
    </p>
    <ul class="flex flex-wrap gap-x-4 gap-y-2">
      {
        links.map(({ NAME, HREF }) => (
          <li>
            <a href={HREF} class="link" rel={HREF.startsWith("http") ? "me noopener" : undefined}>
              {NAME}
            </a>
          </li>
        ))
      }
    </ul>
  </Container>
</footer>
