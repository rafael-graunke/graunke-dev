---
import type { CollectionEntry } from "astro:content";

type Props = { links: CollectionEntry<"projects">["data"]["links"] };
const { links } = Astro.props;

const items = [
  { label: "Live", href: links.live },
  { label: "Repository", href: links.repo },
  { label: "Demo video", href: links.demo_video },
].filter((l): l is { label: string; href: string } => Boolean(l.href));
---

{
  items.length > 0 ? (
    <ul class="flex flex-wrap gap-2">
      {items.map(({ label, href }) => (
        <li>
          <a href={href} class="btn" rel="noopener">
            {label}
            <span class="sr-only">(opens external site)</span>
            <svg class="size-3.5 opacity-60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M7 17 17 7M8 7h9v9" />
            </svg>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p><span class="todo">TODO</span> No public links yet.</p>
  )
}
