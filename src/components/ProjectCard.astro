---
import type { CollectionEntry } from "astro:content";
import StatusBadge from "@components/StatusBadge.astro";
import { projectSlug } from "@lib/utils";

type Props = { project: CollectionEntry<"projects">; headingLevel?: "h2" | "h3" };
const { project, headingLevel: Heading = "h3" } = Astro.props;
const { title, summary, status, stack } = project.data;
---

<article class="card card-hover group relative flex h-full flex-col gap-3 p-5">
  <div class="flex items-start justify-between gap-3">
    <Heading class="font-semibold text-zinc-900 dark:text-zinc-100">
      <a href={`/projects/${projectSlug(project)}`} class="after:absolute after:inset-0 after:rounded-lg">
        {title}
      </a>
    </Heading>
    <StatusBadge status={status} />
  </div>
  <p class="text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{summary}</p>
  {
    stack.length > 0 && (
      <ul class="mt-auto flex flex-wrap gap-1.5 pt-1" aria-label="Stack">
        {stack.map((s) => (
          <li class="tag">{s}</li>
        ))}
      </ul>
    )
  }
</article>
