---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import ProjectCard from "@components/ProjectCard.astro";
import PostItem from "@components/PostItem.astro";
import { HOME, SITE, SOCIALS } from "@consts";
import { getPosts, getProjects } from "@lib/utils";

const featured = (await getProjects()).filter((p) => p.data.featured);

const posts = (await getPosts()).slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);
const github = SOCIALS.find((s) => s.NAME === "GitHub")!;
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container class="space-y-20">
    <section aria-labelledby="hero-title" class="space-y-6 pt-4">
      <p class="font-mono text-sm text-zinc-500">
        {SITE.NAME} · {SITE.TITLE}
      </p>
      <h1 id="hero-title" class="max-w-2xl text-3xl font-semibold tracking-tight text-balance text-zinc-950 sm:text-4xl dark:text-white">
        I build backend systems and web apps, and I know what happens below them, down to servers and networks.
      </h1>
      <p class="max-w-2xl text-lg leading-relaxed text-pretty text-zinc-600 dark:text-zinc-400">
        Software engineer with 5+ years across IT infrastructure, cloud and full-stack development.
        I work mostly with Python, Django and React on AWS, and I like problems where the solution
        isn't obvious before you start.
      </p>
      <div class="flex flex-wrap gap-3 pt-2">
        <a href="/about" class="btn btn-primary">About Me</a>
        <a href={SITE.CV} class="btn">Download CV</a>
        <a href={github.HREF} class="btn" rel="me noopener">GitHub</a>
      </div>
    </section>

    <section aria-labelledby="featured-title" class="space-y-6">
      <div class="flex items-baseline justify-between gap-4">
        <h2 id="featured-title" class="section-title">Featured projects</h2>
        <a href="/projects" class="link text-sm">All projects</a>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2">
        {
          featured.map((project, i) => (
            <li class={i === 0 && featured.length % 2 === 1 ? "sm:col-span-2" : undefined}>
              <ProjectCard project={project} />
            </li>
          ))
        }
      </ul>
    </section>

    {
      posts.length > 0 && (
        <section aria-labelledby="writing-title" class="space-y-4">
          <div class="flex items-baseline justify-between gap-4">
            <h2 id="writing-title" class="section-title">Latest writing</h2>
            <a href="/writing" class="link text-sm">All writing</a>
          </div>
          <ul class="divide-y divide-zinc-200 dark:divide-zinc-800">
            {posts.map((post) => (
              <li>
                <PostItem post={post} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </Container>
</PageLayout>
