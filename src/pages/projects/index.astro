---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import ProjectCard from "@components/ProjectCard.astro";
import { PROJECTS } from "@consts";
import { getProjects } from "@lib/utils";

const projects = await getProjects();
---

<PageLayout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION} image="/og/projects.png">
  <Container class="space-y-10">
    <header class="space-y-3">
      <h1 class="text-3xl font-semibold tracking-tight text-zinc-950 dark:text-white">Projects</h1>
      <p class="max-w-2xl text-zinc-600 dark:text-zinc-400">
        Each project page covers the problem, how it works, the decisions behind it, and what's next.
      </p>
    </header>
    <ul class="grid gap-4 sm:grid-cols-2">
      {
        projects.map((project) => (
          <li>
            <ProjectCard project={project} headingLevel="h2" />
          </li>
        ))
      }
    </ul>
  </Container>
</PageLayout>
